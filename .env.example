# AIエージェントはローカルの claude CLI をサブプロセスとして呼び出す
# （事前に `claude login` でClaude Pro/Maxアカウントにログインしておくこと。追加課金は発生しない）
# claude コマンドがPATHに無い場合のみ、フルパスを指定する
CLAUDE_CLI_PATH=

# プロジェクト固有のビルドコマンドを追加で許可したい場合、
# "Bash(コマンド接頭辞 *)" 形式でカンマ区切り指定する
# 例: AGENT_EXTRA_BASH_RULES=Bash(./build.sh *),Bash(make *)
AGENT_EXTRA_BASH_RULES=
